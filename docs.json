{
  "$schema": "https://mintlify.com/docs.json",
  "name": "EVCore",
  "theme": "aspen",
  "colors": {
    "primary": "#ef7025",
    "light": "#eec9bc",
    "dark": "#4fa1ab"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "quickstart",
              "project-status",
              "architecture"
            ]
          },
          {
            "group": "EVCore Studio",
            "pages": [
              "studio/overview",
              "studio/accounts-and-licensing",
              "studio/firmware-updates",
              "studio/release"
            ]
          },
          {
            "group": "Firmware",
            "pages": [
              "firmware/safety-manager",
              "firmware/diagnostic-engine",
              "firmware/host-protocol",
              "firmware/calibration",
              "firmware/simulator"
            ]
          },
          {
            "group": "Hardware & Safety",
            "pages": [
              "hardware/baseline",
              "hardware/open-items",
              "safety/hazard-analysis",
              "safety/requirements"
            ]
          },
          {
            "group": "Engineering",
            "pages": [
              "engineering/testing",
              "engineering/coding-standard",
              "engineering/versioning",
              "engineering/knowledge-database",
              "engineering/decisions",
              "engineering/roadmap"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "/quickstart"
    }
  },
  "footer": {
    "socials": {}
  },
  "redirects": [
    {
      "source": "/introduction",
      "destination": "/"
    },
    {
      "source": "/get-started/:slug*",
      "destination": "/quickstart"
    },
    {
      "source": "/guides/:slug*",
      "destination": "/studio/overview"
    },
    {
      "source": "/configuration/:slug*",
      "destination": "/studio/overview"
    },
    {
      "source": "/support/changelog",
      "destination": "/engineering/versioning"
    },
    {
      "source": "/support/:slug*",
      "destination": "/"
    },
    {
      "source": "/code/overview",
      "destination": "/architecture"
    },
    {
      "source": "/code/architecture",
      "destination": "/architecture"
    },
    {
      "source": "/code/conventions",
      "destination": "/engineering/coding-standard"
    },
    {
      "source": "/code/api/:slug*",
      "destination": "/firmware/host-protocol"
    },
    {
      "source": "/code/advanced/versioning",
      "destination": "/engineering/versioning"
    },
    {
      "source": "/code/:slug*",
      "destination": "/"
    }
  ]
}
